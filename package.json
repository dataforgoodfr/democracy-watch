{
  "name": "democracy-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @democracy-watch/web dev",
    "dev:docs": "pnpm --filter @democracy-watch/docs dev",
    "build": "pnpm --filter @democracy-watch/web --filter @democracy-watch/docs build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brand": "pnpm --filter @democracy-watch/brand generate",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "catalog:",
    "lefthook": "2.2.2",
    "typescript": "catalog:",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.9.1"
}
