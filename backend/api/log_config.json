{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "dw": {"format": "%(asctime)s %(levelname)-7s %(name)s : %(message)s", "datefmt": "%H:%M:%S"}
  },
  "filters": {
    "errors_only": {"()": "democracy_watch.log.ErrorStatusFilter"}
  },
  "handlers": {
    "stderr": {"class": "logging.StreamHandler", "formatter": "dw"}
  },
  "loggers": {
    "democracy_watch": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.access": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false,
      "filters": ["errors_only"]
    }
  }
}
