{
  "name": "@democracy-watch/theme",
  "private": true,
  "type": "module",
  "description": "Tokens du styleguide (--dw-*) et thème Mantine. Source unique des valeurs visuelles.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./classes.css": "./src/classes.css"
  },
  "scripts": {
    "generate": "node scripts/generate-css.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/spectral": "5.3.0"
  },
  "peerDependencies": {
    "@mantine/core": "*"
  },
  "devDependencies": {
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
