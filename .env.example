PGHOST=localhost
PGPORT=1234
PGDATABASE=democracy_watch_db
PGUSER=pg_user
PGPASSWORD=pg_password
DATABASE_URL="postgresql+asyncpg://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT/$PGDATABASE"

KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="master"
KEYCLOAK_CLIENT_ID="democracy_watch_api"

# Meilisearch local (docker-compose). Hors local : clé de recherche seule, jamais la clé maître.
MEILI_MASTER_KEY="local_master_key_change_me"
MEILI_URL="http://localhost:7700"
MEILI_API_KEY="$MEILI_MASTER_KEY"
