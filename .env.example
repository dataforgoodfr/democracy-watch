PGHOST=localhost
PGPORT=1234
PGDATABASE=democracy_watch_db
PGUSER=pg_user
PGPASSWORD=pg_password
DATABASE_URL="postgresql+asyncpg://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT/$PGDATABASE"

# Données de l'API : base DuckDB au modèle V3, fichier local ou URL s3://bucket/clair.duckdb.
DATA_PATH=backend/source_data/clair_dw_model_zstd.duckdb
# S3 : sans clé, lecture anonyme. Endpoint pour un stockage compatible (ex. s3.fr-par.scw.cloud).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mot de passe partagé de l'API v0 (en-tête Authorization: Bearer …) ; vide : /api/v0 répond 503.
API_PASSWORD=

KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="master"
KEYCLOAK_CLIENT_ID="democracy_watch_api"

# Meilisearch local (docker-compose). Hors local : clé de recherche seule, jamais la clé maître.
MEILI_MASTER_KEY="local_master_key_change_me"
MEILI_URL="http://localhost:7700"
MEILI_API_KEY="$MEILI_MASTER_KEY"
